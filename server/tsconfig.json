{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "skipLibCheck": true,
    "types": [
      "bun"
    ],
    "paths": {
      "~/*": [
        "../src/*"
      ],
      "styled-system/*": [
        "../styled-system/*"
      ]
    },
    "jsx": "react-jsx"
  },
  "include": [
    "src",
    "test",
    "drizzle.config.ts"
  ]
}
