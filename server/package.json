{
  "name": "the-sorter-server",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "start": "bun src/index.ts",
    "build": "bun build src/index.ts --outfile=./build/server --compile --minify-whitespace --target=bun",
    "test": "bun test",
    "type-check": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:up": "docker compose -f docker-compose.dev.yml up -d",
    "db:down": "docker compose -f docker-compose.dev.yml down"
  },
  "dependencies": {
    "@elysiajs/cors": "^1.4.0",
    "@elysiajs/cron": "^1.4.1",
    "drizzle-orm": "^0.45.1",
    "elysia": "^1.4.22",
    "elysia-rate-limit": "^4.4.2",
    "pino": "^9.7.0",
    "postgres": "^3.4.8"
  },
  "devDependencies": {
    "@types/bun": "^1.3.4",
    "drizzle-kit": "^0.31.8",
    "typescript": "^5.9.3"
  }
}
