# Copy to server/.env on the host (next to docker-compose.yml).

# Required. Use the Postgres container/service name as host if it runs in Docker, not localhost.
DATABASE_URL=postgres://sorter:<password>@<db-host>:5432/sorter
# Local dev with docker-compose.dev.yml: postgres://sorter:sorter@localhost:5433/sorter
# Site allowed to call the API (comma-separated).
CORS_ORIGINS=https://hamproductions.github.io
# Header carrying the visitor IP. cf-connecting-ip behind Cloudflare (proxied DNS or Tunnel).
# Empty means every visitor shares one rate limit.
CLIENT_IP_HEADER=cf-connecting-ip
# Unlocks /admin. Generate with: openssl rand -hex 32
ADMIN_TOKEN=

# Optional.
# Host port the container is published on (127.0.0.1 only). The server itself always listens on 3000.
# API_PORT=3100
# Refresh song/character data hourly instead of using the data built into the image.
# DATA_BASE_URL=https://raw.githubusercontent.com/hamproductions/the-sorter/main/data
# LOG_LEVEL=info
